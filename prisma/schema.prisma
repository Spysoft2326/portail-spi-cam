// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String       @id @default(cuid())
  name                  String?
  email                 String?      @unique
  emailVerified         DateTime?
  image                 String?
  password              String? // mot de passe haché (bcrypt)
  role                  String       @default("AGENT_SAISIE") // AGENT_SAISIE < ADMIN < SUPER_ADMIN (voir lib/rbac.ts)
  // Identifiant de connexion (en minuscules), utilisable à la place de l'email, ex. "spysoft"
  identifiant           String?      @unique
  actif                 Boolean      @default(true) // un compte désactivé ne peut plus se connecter
  // Imposé après création ou réinitialisation (mot de passe par défaut) : changement obligatoire à la connexion
  doitChangerMotDePasse Boolean      @default(false)
  tentativesEchouees    Int          @default(0) // échecs de connexion consécutifs
  bloqueJusqua          DateTime? // verrouillage temporaire après trop d'échecs
  derniereConnexion     DateTime?
  createdAt             DateTime     @default(now())
  accounts              Account[]
  sessions              Session[]
  entreprises           Entreprise[] @relation("AgentEntreprises")
  auditLogs             AuditLog[]
  productionsSaisies    Production[] @relation("SaisiePar")
  productionsValidees   Production[] @relation("ValidePar")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Entreprise {
  id                      String          @id @default(uuid())
  referenceSPI            String          @unique
  denomination            String
  sigle                   String?
  formeJuridique          String?
  capitalSocial           Float?
  adresse                 String?
  ville                   String?
  departement             String?
  region                  String
  telephone               String?
  email                   String?
  nomContact              String?
  siteWeb                 String?
  numContribuable         String? // NIU (unicité contrôlée par l'API)
  // Libellé de la filière, conservé pour l'affichage public et la conjoncture (renseigné automatiquement)
  secteurActivite         String          @default("AUTRE")
  sousSecteur             String?
  // Activité principale codée : classe de la nomenclature (CITI Rév.4, base de la NACAM)
  activiteCode            String?
  activite                Activite?       @relation("ActivitePrincipale", fields: [activiteCode], references: [code])
  // Filière : déduite de l'activité par la table de passage, sauf si fixée manuellement
  filiereCode             String?
  filiere                 Filiere?        @relation(fields: [filiereCode], references: [code])
  filiereManuelle         Boolean         @default(false)
  // Champ industriel = sections B, C, D, E de la nomenclature (déduit de l'activité)
  champIndustriel         Boolean         @default(true)
  taille                  String? // GE, PME, TPE
  produitsPrincipaux      String?
  statut                  String          @default("ACTIF") // EN_ATTENTE, ACTIF, REJETE, INACTIF
  motifRejet              String? // motif saisi par l'admin lors d'un rejet
  estExportateur          Boolean         @default(false)
  estDansZoneIndustrielle Boolean         @default(false)
  nomZoneIndustrielle     String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  agentId                 String?
  agent                   User?           @relation("AgentEntreprises", fields: [agentId], references: [id])
  productions             Production[]
  produits                Produit[]
  etablissements          Etablissement[]

  @@index([filiereCode])
  @@index([activiteCode])
}

// Nomenclature des activités : CITI Rév.4 (ONU, 2008), sur laquelle repose la NACAM de l'INS.
// Hiérarchie : SECTION (A..U) > DIVISION (2 chiffres) > GROUPE (3) > CLASSE (4).
model Activite {
  code           String          @id
  libelle        String
  niveau         String // SECTION, DIVISION, GROUPE, CLASSE
  parentCode     String?
  parent         Activite?       @relation("ActiviteHierarchie", fields: [parentCode], references: [code])
  enfants        Activite[]      @relation("ActiviteHierarchie")
  section        String // lettre de section, pour filtrer rapidement
  codeNacam      String? // correspondance NACAM Rév.1, à renseigner à partir du texte officiel de l'INS
  entreprises    Entreprise[]    @relation("ActivitePrincipale")
  etablissements Etablissement[]

  @@index([niveau])
  @@index([section])
}

// Filières industrielles (pilotage MINMIDT / SND30)
model Filiere {
  code        String         @id
  libelle     String
  prioritaire Boolean        @default(false) // sous-secteur prioritaire de la SND30
  ordre       Int            @default(0)
  regles      FiliereRegle[]
  entreprises Entreprise[]
}

// Table de passage nomenclature -> filière : un préfixe de code CITI rattaché à une filière.
// Le préfixe le plus long l'emporte (ex. "4661" commerce de combustibles -> Hydrocarbures).
model FiliereRegle {
  id          String  @id @default(uuid())
  prefixe     String  @unique
  filiereCode String
  filiere     Filiere @relation(fields: [filiereCode], references: [code], onDelete: Cascade)
}

// Établissement (site, usine) d'une entreprise : une entreprise peut en avoir plusieurs.
model Etablissement {
  id                  String     @id @default(uuid())
  entrepriseId        String
  entreprise          Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom                 String? // ex. "Usine de Bonabéri"
  principal           Boolean    @default(false)
  activiteCode        String?
  activite            Activite?  @relation(fields: [activiteCode], references: [code])
  region              String?
  departement         String?
  ville               String?
  quartier            String?
  lieuDit             String?
  adresse             String?
  telephone           String?
  // Établissement classé (loi n° 98/015 du 14 juillet 1998) : "1" ou "2" (classe), vide si non classé
  classeEtablissement String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([entrepriseId])
}

// Catalogue des produits d'une entreprise (une entreprise peut avoir plusieurs produits)
model Produit {
  id           String            @id @default(uuid())
  entrepriseId String
  entreprise   Entreprise        @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom          String
  unite        String // unité de mesure par défaut : t, kg, hl, L, m3, unités...
  codeNpc      String? // code produit de la NPC (nomenclature des produits du Cameroun), optionnel
  actif        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  lignes       LigneProduction[]

  @@unique([entrepriseId, nom])
}

// Déclaration trimestrielle d'une entreprise (une par entreprise et par trimestre).
// Workflow : EN_ATTENTE (saisie agent) -> VALIDE ou REJETE (admin, avec motif)
//            REJETE -> corrigée par l'agent -> EN_ATTENTE
model Production {
  id                 String            @id @default(uuid())
  entrepriseId       String
  entreprise         Entreprise        @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  // Champs historiques (anciennes saisies mono-produit), conservés pour compatibilité
  produit            String?
  quantite           Float?
  unite              String?
  periode            String?
  annee              Int?
  trimestre          Int?
  productionPhysique Float?
  chiffreAffaires    Float? // FCFA, total de l'entreprise sur le trimestre
  effectifs          Int? // effectif total de l'entreprise (pas par produit)
  commentaire        String?
  statut             String            @default("EN_ATTENTE") // EN_ATTENTE, VALIDE, REJETE
  motifRejet         String?
  saisiePar          String? // ID de l'agent qui a saisi
  agentSaisie        User?             @relation("SaisiePar", fields: [saisiePar], references: [id])
  validePar          String? // ID de l'admin qui a validé ou rejeté
  adminValidation    User?             @relation("ValidePar", fields: [validePar], references: [id])
  dateValidation     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lignes             LigneProduction[]

  @@index([entrepriseId])
  @@index([annee, trimestre])
}

// Ligne produit d'une déclaration : quantité produite d'un produit sur le trimestre
model LigneProduction {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  produitId    String?
  produitRef   Produit?   @relation(fields: [produitId], references: [id], onDelete: SetNull)
  produit      String // nom du produit au moment de la saisie
  quantite     Float
  unite        String

  @@index([productionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ConfigSystem {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
